# Shared config for the integration tests under tests/ — sourced by each test.
#
# These are defaults. Override any of them by exporting the variable before
# running (an exported value wins over what's set here), e.g.:
#   UPGRADE_AUTHORITY=kms://… tests/test-write-buffer.sh 4
#
# No secrets live here — only URLs and keypair/URI paths.

: "${URL:=https://api.test.sphere.net}"                # target cluster RPC
: "${PAYER:=$HOME/.config/solana/id.json}"             # pays + signs chunk writes

# Phase 4 only: the deploy/upgrade authority. MUST be an APPROVED deployer
# (`spherenet-admin pw show`). Keypair path or kms:// URI. Defaults to PAYER.
: "${UPGRADE_AUTHORITY:=$PAYER}"
